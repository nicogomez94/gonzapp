generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ListingStatus {
  ACTIVE
  PAUSED
  EXPIRED
  PENDING
}

model Plan {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  maxImages   Int
  daysActive  Int
  features    String[]
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  phone     String?
  role      Role      @default(USER)
  plan      Plan?     @relation(fields: [planId], references: [id])
  planId    Int?
  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Listing {
  id           Int           @id @default(autoincrement())
  title        String
  brand        String
  model        String
  engine       String
  year         Int
  mileage      Int
  fuel         String
  transmission String
  description  String
  equipment    String[]
  priceArs     Float
  priceUsd     Float?
  images       String[]
  location     String
  phone        String
  status       ListingStatus @default(ACTIVE)
  featured     Boolean       @default(false)
  verified     Boolean       @default(false)
  user         User          @relation(fields: [userId], references: [id])
  userId       Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
